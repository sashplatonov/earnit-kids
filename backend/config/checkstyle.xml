<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Checkstyle configuration for EarnIt Kids Backend (Google style, relaxed). -->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- File-level checks -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>
    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter"/>

    <!-- Project Java rules are enforced under TreeWalker (below). -->
    <module name="TreeWalker">
        <!-- Project Java rules: forbid Javadoc and nested types -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="/\*\*"/>
            <property name="message" value="Javadoc comments are forbidden by project policy. Use // comments instead."/>
            <property name="ignoreComments" value="false"/>
            <property name="severity" value="error"/>
        </module>

        <module name="RegexpSinglelineJava">
            <property name="format" value="^[ \\t]+(public|protected|private)?\\s*(static\\s+)?(class|interface|enum)\\s+\\w+"/>
            <property name="message" value="Nested types are forbidden. Place each type in its own top-level file."/>
            <property name="ignoreComments" value="true"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Block comments (non-Javadoc) are forbidden by project policy -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="/\*(?!\*)"/>
            <property name="message" value="Block comments are forbidden by project policy. Use 'EXPLAIN:' single-line comments for complex algorithms or bugfixes."/>
            <property name="ignoreComments" value="false"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Inline comments: only allowed when starting with EXPLAIN:/FIXME: etc. Avoid http:// by negative lookbehind for ':' -->
        <module name="RegexpSinglelineJava">
            <!-- Allow lines that include an EXPLAIN: marker anywhere; flag other inline comments -->
            <property name="format" value="^(?!.*EXPLAIN:).*//"/>
            <property name="message" value="Inline comments are forbidden by project policy except explanatory comments starting with 'EXPLAIN:' or markers like 'FIXME'."/>
            <property name="ignoreComments" value="false"/>
            <property name="severity" value="error"/>
        </module>
        <!-- Naming conventions -->
        <module name="TypeName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>

        <!-- Import hygiene -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Block structure -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- Size limits -->
        <module name="MethodLength">
            <property name="max" value="60"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="10"/>
        </module>

        <!-- Coding hygiene -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Throwable"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- Misc -->
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
    </module>
</module>
