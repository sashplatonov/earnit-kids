# EarnIt Kids - consolidated .gitignore
# See also: .claudeignore, .codexignore, .dockerignore for tool-specific ignores

# Environment
.env
.env.local
.env.*.local
.env.production
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/node_modules/

# Builds / outputs
dist/
build/
coverage/
public/dist/
public/build/
.svelte-kit/
.vite/
.out/
.out-tsc/

# Framework outputs
.next/
.nuxt/
.output/
.turbo/

# Java / Maven / Quarkus
target/
**/target/
*.class
*.jar
*.war
*.ear

# Mobile
mobile/node_modules/
android/
ios/
build/
*.keystore
*.jks
release-key.properties
key.properties
signing.properties

# IDE / Editor
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs / temp
logs/
*.log
tmp/
.tmp/
.cache/

# Test artifacts
test-results/
playwright-report/
.playwright-browsers/

# Data / local dumps
data/*
!data/backups/
data/backups/*
!data/backups/.gitkeep
data.json

# Agent tools (do not track local agent storage)
.claude/
.codex/
.copilot/
.mcp/
.mcp.json

# Docker
.dockerignore

# Misc
/out/
*.bak
