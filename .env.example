# -------------------------------
# URLs and ports
# -------------------------------
# Public origin of the web app. Must be the site root (no path/query), e.g.
# https://earnit-kids.igo.mywire.org — never a specific app page like /en/app/tasks.
APP_URL=http://localhost:3000
WEB_PORT=3000
WEB_INTERNAL_PORT=3000
BACKEND_INTERNAL_PORT=8080
# -------------------------------
# Web edge
# -------------------------------
VITE_NEW_RELIC_BROWSER_ENABLED=false
VITE_NEW_RELIC_BROWSER_INFO=
VITE_NEW_RELIC_BROWSER_INIT=
VITE_NEW_RELIC_BROWSER_LOADER_CONFIG=

# -------------------------------
# Quarkus backend
# -------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:4174,http://localhost:4174,http://e2e.localhost:4174
JWT_SECRET=local-dev-secret-change-in-prod
SESSION_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=7776000
PRODUCTION=false
JAVA_XMX=2500m

# -------------------------------
# Database
# -------------------------------
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5432
DB_INTERNAL_PORT=5432
DB_NAME=earnit_kids
DB_USER=postgres
DB_PASSWORD=change-me
DB_SCHEMA=earnit_kids
# Local backend runs can use DATABASE_URL directly. Docker Compose overrides it per service.
DATABASE_URL=jdbc:postgresql://localhost:5432/earnit_kids

# -------------------------------
# Admin bootstrap
# -------------------------------
SUPER_ADMIN_EMAIL=admin@example.com

# -------------------------------
# Feature flags
# -------------------------------
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RECOVERY=false
ENABLE_TELEGRAM_MINI_APP=false
ENABLE_TELEGRAM_BOT=false
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_ROLLOUT_FAMILY_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Comma-separated list of Telegram user IDs that have admin access to the dashboard.
# Example: TELEGRAM_ADMIN_USER_IDS=123456789,987654321
# Admin privileges are based on Telegram user ID only, never username or email.
TELEGRAM_ADMIN_USER_IDS=
# Public HTTPS Mini App URL. Set this AND BotFather's Main Mini App URL to
# https://your-domain/telegram. This is the URL Telegram opens inside the bot
# (used by the backend for bot keyboard buttons and webhook registration).
# The public site "Открыть в Telegram" buttons build a short deep link
# https://t.me/<TELEGRAM_BOT_USERNAME>?startapp=home — the Mini App URL itself
# lives in BotFather, NOT in the startapp parameter (Telegram rejects URL-shaped
# startapp values with START_PARAM_INVALID). To override the startapp command,
# set TELEGRAM_MINI_APP_URL to a full t.me deep link
# (e.g. https://t.me/your_bot?startapp=custom).
TELEGRAM_MINI_APP_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CALLBACK_SIGNING_SECRET=
TELEGRAM_CALLBACK_TTL_SECONDS=300
TELEGRAM_CALLBACK_MENU_VERSION=1
# Reconcile the public Telegram webhook after startup in case a transient network failure occurred.
TELEGRAM_WEBHOOK_REGISTRATION_INTERVAL=5m
ENABLE_TELEGRAM_RETENTION=true
TELEGRAM_RETENTION_POLL_INTERVAL=24h
TELEGRAM_INVITE_RETENTION_DAYS=30
TELEGRAM_CALLBACK_RETENTION_DAYS=30
TELEGRAM_WEBHOOK_UPDATE_RETENTION_DAYS=30
TELEGRAM_DELIVERY_RETENTION_DAYS=30
TELEGRAM_OUTBOX_RETENTION_DAYS=30
TELEGRAM_AUDIT_RETENTION_DAYS=365
TELEGRAM_RETENTION_BATCH_SIZE=100

# -------------------------------
# Google Identity (Google Sign-In)
# Enable provider-based sign-in for existing parent accounts.
# Example: ENABLE_GOOGLE_AUTH=true
# Provide the OAuth 2.0 Client ID from Google Cloud Console (web application):
# GOOGLE_AUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# The redirect URI must exactly match a Google Cloud Console authorized redirect URI.
# Example: GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/login-google/callback
# -------------------------------
ENABLE_GOOGLE_AUTH=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=

# -------------------------------
# Monitoring
# -------------------------------
# Consumed via app.performance.http-metrics.* mappings in application.properties.
HTTP_METRICS_PAYLOAD_ESTIMATION_ENABLED=true
HTTP_METRICS_PAYLOAD_ESTIMATION_MAX_COLLECTION_SIZE=256
HTTP_METRICS_SLOW_REQUEST_THRESHOLD_MS=750
HTTP_METRICS_SLOW_QUERY_THRESHOLD_MS=250
BASE_DATA_CACHE_TTL=PT5M
ANALYTICS_CACHE_TTL=PT60S
FAMILY_DB_ID_CACHE_TTL=PT10M
ADMIN_DASHBOARD_CACHE_TTL=PT2M
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=earnit-kids-backend
NEW_RELIC_AGENT_ENABLED=false
DEPLOYMENT_ENV=development
NEW_RELIC_METRICS_ENABLED=false
NEW_RELIC_OTLP_METRICS_ENDPOINT=https://otlp.nr-data.net
NEW_RELIC_OTLP_METRICS_PROTOCOL=http/protobuf
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED=10000
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=false
