# -------------------------------
# Core URLs and ports
# -------------------------------
# Public URL used in links and reverse-proxy headers.
APP_URL=http://localhost:3000
# Host port for the web container in docker-compose.
WEB_PORT=3000
WEB_INTERNAL_PORT=3000
# Host/internal ports for Java backend.
BACKEND_PORT=8080
BACKEND_INTERNAL_PORT=8080
# Host port for PostgreSQL when profile `db` is enabled.
DB_PORT=5432

# -------------------------------
# Web edge service
# -------------------------------
PORT=3000
BACKEND_URL=http://backend:8080

# -------------------------------
# Quarkus backend
# -------------------------------
QUARKUS_HTTP_PORT=8080
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
PRODUCTION=false

# PostgreSQL connection used by Quarkus.
# Use jdbc URL for Quarkus runtime.
DATABASE_URL=jdbc:postgresql://db:5432/earnit_kids
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=earnit_kids

# -------------------------------
# Optional reserve database (legacy tooling)
# -------------------------------
RESERVE_DATABASE_URL=postgresql://postgres:postgres@db:5432/earnit_kids_reserve

# -------------------------------
# Compose db profile bootstrap values
# -------------------------------
POSTGRES_DB=earnit_kids
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -------------------------------
# Admin bootstrap credentials
# -------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# -------------------------------
# Feature flags
# -------------------------------
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RECOVERY=false

# -------------------------------
# Mailgun (optional)
# -------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_Username=api
MAILGUN_Endpoint=https://api.mailgun.net
MAILGUN_FROM="EarnIt Kids <no-reply@example.com>"

# -------------------------------
# Push notifications (optional)
# -------------------------------
ENABLE_PUSH_NOTIFICATIONS=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
# FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# -------------------------------
# Monitoring / backups (optional)
# -------------------------------
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_INTERVAL_HOURS=24

# -------------------------------
# Optional analytics
# -------------------------------
CLARITY_PROJECT_ID=
