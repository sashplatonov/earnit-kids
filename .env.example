# -------------------------------
# Core URLs and ports
# -------------------------------
# Public URL used in links and reverse-proxy headers.
APP_URL=http://localhost:3000
# Host port for the web container in docker-compose.
WEB_PORT=3000
WEB_INTERNAL_PORT=3000
# Host/internal ports for Java backend.
BACKEND_INTERNAL_PORT=8080

# -------------------------------
# Web edge service
# -------------------------------
PORT=3000
BACKEND_URL=http://backend:8080

# -------------------------------
# Quarkus backend
# -------------------------------
QUARKUS_HTTP_PORT=8080
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
PRODUCTION=true
JAVA_XMX=2500m

# Database (canonical env names)
# Use DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD for clarity.
# Example values (adjust for your environment):
DB_HOST=db
DB_PORT=5432
DB_NAME=earnit_kids
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=earnit_kids

# For Quarkus we also provide a ready-to-use JDBC URL. Docker Compose
# will expand the DB_* variables into this value at runtime when set
# in the compose `environment` mappings.
DATABASE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# (legacy) reserve database URL removed from examples to avoid duplication.

# -------------------------------
# Admin bootstrap credentials
# -------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# -------------------------------
# Feature flags
# -------------------------------
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RECOVERY=false

# -------------------------------
# Mailgun (optional)
# -------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_Username=api
MAILGUN_Endpoint=https://api.mailgun.net
MAILGUN_FROM="EarnIt Kids <no-reply@example.com>"

# -------------------------------
# Push notifications (optional)
# -------------------------------
ENABLE_PUSH_NOTIFICATIONS=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
# FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# -------------------------------
# Monitoring / backups (optional)
# -------------------------------
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_INTERVAL_HOURS=24

# -------------------------------
# Optional analytics
# -------------------------------
CLARITY_PROJECT_ID=
