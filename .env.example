# =====================================================
# Required: local Compose stack
# =====================================================
# Public site origin. Keep this distinct from WEB_PORT, the host port below.
APP_URL=http://localhost:3000
PUBLIC_AUTH_RATE_LIMIT_ENABLED=true
PUBLIC_AUTH_RATE_LIMIT_CHILD_MAX_REQUESTS=5
PUBLIC_AUTH_RATE_LIMIT_CHILD_WINDOW_SECONDS=60
PUBLIC_AUTH_RATE_LIMIT_PARENT_MAX_REQUESTS=5
PUBLIC_AUTH_RATE_LIMIT_PARENT_WINDOW_SECONDS=60
PUBLIC_AUTH_RATE_LIMIT_OAUTH_START_MAX_REQUESTS=10
PUBLIC_AUTH_RATE_LIMIT_OAUTH_START_WINDOW_SECONDS=60
PUBLIC_AUTH_RATE_LIMIT_OAUTH_CALLBACK_MAX_REQUESTS=5
PUBLIC_AUTH_RATE_LIMIT_OAUTH_CALLBACK_WINDOW_SECONDS=60
PUBLIC_AUTH_RATE_LIMIT_TELEGRAM_MAX_REQUESTS=10
PUBLIC_AUTH_RATE_LIMIT_TELEGRAM_WINDOW_SECONDS=60
PARENT_INVITATION_MAIL_PROVIDER=disabled
# Host port published for the web container; the container always listens on 3000.
WEB_PORT=3000
# Internal service ports used by the selected Compose stack.
BACKEND_INTERNAL_PORT=8080
DB_INTERNAL_PORT=5432
# Local-only signing secret. Replace it for any shared or production deployment.
JWT_SECRET=local-dev-secret-change-in-prod
PARENT_INVITATION_ACTIVE_KEY_ID=v1
PARENT_INVITATION_ACTIVE_KEY=local-parent-invitation-key-change-in-prod
# During rotation, set both previous values to the immediately retired key.
PARENT_INVITATION_PREVIOUS_KEY_ID=
PARENT_INVITATION_PREVIOUS_KEY=
# PostgreSQL connection and credentials for the Compose db service.
DB_HOST=db
DB_HOST_PORT=5432
DB_NAME=earnit_kids
DB_USER=postgres
DB_PASSWORD=change-me

# =====================================================
# Optional: Google OAuth
# Set these to enable Google sign-in for existing parent accounts.
# =====================================================
ENABLE_GOOGLE_AUTH=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/login-google/callback when empty.
GOOGLE_AUTH_REDIRECT_URI=

# =====================================================
# Optional: Telegram integration
# Set the feature flags and credentials only when operating Telegram flows.
# =====================================================
ENABLE_TELEGRAM_MINI_APP=false
ENABLE_TELEGRAM_BOT=false
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_ROLLOUT_FAMILY_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user IDs with dashboard admin access.
TELEGRAM_ADMIN_USER_IDS=
# Public Mini App URL/deep-link override. Leave empty to use the APP_URL default.
TELEGRAM_MINI_APP_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CALLBACK_SIGNING_SECRET=
TELEGRAM_CALLBACK_TTL_SECONDS=300
TELEGRAM_CALLBACK_MENU_VERSION=1
TELEGRAM_REPLY_KEYBOARD_VERSION=4
# Reconcile the public webhook after startup; set only when Bot API registration is used.
TELEGRAM_WEBHOOK_REGISTRATION_INTERVAL=5m
FAMILY_DASHBOARD_CATALOG_CACHE_TTL=5s
ENABLE_TELEGRAM_OUTBOX=true
TELEGRAM_OUTBOX_POLL_INTERVAL=10s
TELEGRAM_OUTBOX_MAX_ATTEMPTS=5
ENABLE_TELEGRAM_RETENTION=true
ENABLE_WEB_PUSH=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.invalid
WEB_PUSH_MAX_ATTEMPTS=5
TELEGRAM_RETENTION_POLL_INTERVAL=24h
TELEGRAM_INVITE_RETENTION_DAYS=30
TELEGRAM_CALLBACK_RETENTION_DAYS=30
TELEGRAM_WEBHOOK_UPDATE_RETENTION_DAYS=30
TELEGRAM_DELIVERY_RETENTION_DAYS=30
TELEGRAM_OUTBOX_RETENTION_DAYS=30
TELEGRAM_AUDIT_RETENTION_DAYS=365
TELEGRAM_RETENTION_BATCH_SIZE=100

# =====================================================
# Optional: monitoring
# Backend performance metrics and New Relic observability. Empty/false values
# keep integrations disabled for local development.
# =====================================================
HTTP_METRICS_PAYLOAD_ESTIMATION_ENABLED=true
HTTP_METRICS_PAYLOAD_ESTIMATION_MAX_COLLECTION_SIZE=256
HTTP_METRICS_SLOW_REQUEST_THRESHOLD_MS=750
HTTP_METRICS_SLOW_QUERY_THRESHOLD_MS=250
DEPLOYMENT_ENV=development
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=earnit-kids-backend
NEW_RELIC_AGENT_ENABLED=false
NEW_RELIC_METRICS_ENABLED=false
NEW_RELIC_OTLP_METRICS_ENDPOINT=https://otlp.nr-data.net
NEW_RELIC_OTLP_METRICS_PROTOCOL=http/protobuf
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED=10000
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=false

# =====================================================
# Optional: cache and backend performance tuning
# Change these only when tuning a running backend; defaults are safe locally.
# =====================================================
BASE_DATA_CACHE_TTL=PT5M
ANALYTICS_CACHE_TTL=PT60S
FAMILY_DB_ID_CACHE_TTL=PT10M
ADMIN_DASHBOARD_CACHE_TTL=PT2M
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:4174,http://localhost:4174,http://e2e.localhost:4174
SESSION_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=7776000
PRODUCTION=false

# =====================================================
# Optional: native image build
# Set this only for docker-compose.native.yml builds to cap builder memory.
# =====================================================
JAVA_XMX=2500m

# =====================================================
# Optional: direct backend and maintenance scripts
# These are not Compose inputs. Use them for a backend run outside Compose or
# for scripts that load the root .env file; Compose supplies DATABASE_URL itself.
# =====================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/earnit_kids
DB_PORT=5432
DB_SCHEMA=earnit_kids
