# -------------------------------
# URLs and ports
# -------------------------------
APP_URL=http://localhost:3000
WEB_PORT=3000
WEB_INTERNAL_PORT=3000
BACKEND_INTERNAL_PORT=8080

# -------------------------------
# Web edge
# -------------------------------
PORT=3000
BACKEND_URL=http://localhost:8080
LOG_LEVEL=debug

# -------------------------------
# Quarkus backend
# -------------------------------
QUARKUS_HTTP_PORT=8080
FRONTEND_URL=http://localhost:3000
JWT_SECRET=local-dev-secret-change-in-prod
PRODUCTION=false
JAVA_XMX=2500m

# -------------------------------
# Database
# -------------------------------
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5432
DB_NAME=earnit_kids
DB_USER=postgres
DB_PASSWORD=change-me
DB_SCHEMA=earnit_kids
# Local backend runs can use DATABASE_URL directly. Docker Compose overrides it per service.
DATABASE_URL=jdbc:postgresql://localhost:5432/earnit_kids

# -------------------------------
# Admin bootstrap
# -------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# -------------------------------
# Feature flags
# -------------------------------
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RECOVERY=false
ENABLE_PUSH_NOTIFICATIONS=false

# -------------------------------
# Google Identity (Google Sign-In)
# Enable provider-based sign-in for existing parent accounts.
# Example: ENABLE_GOOGLE_AUTH=true
# Provide the OAuth 2.0 Client ID from Google Cloud Console (web application):
# GOOGLE_AUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# -------------------------------
ENABLE_GOOGLE_AUTH=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# -------------------------------
# Push
# -------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# -------------------------------
# Monitoring
# -------------------------------
# Telegram backup delivery is configured in the super-admin panel.

# -------------------------------
# Analytics
# -------------------------------
CLARITY_PROJECT_ID=
