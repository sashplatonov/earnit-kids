{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": [
      "vitest/globals",
      "$app/types"
    ],
    "paths": {
      "#lib/*": [
        "./src/lib/*"
      ],
      "#lib": [
        "./src/lib"
      ]
    }
  },
  "include": [
    "scripts/**/*.d.ts",
    "scripts/**/*.d.mts",
    "static/**/*.d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
