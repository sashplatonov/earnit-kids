{
  "name": "earnit-kids-web-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "build:static": "cp svelte.config.js svelte.config.bak.js && cp svelte.config.static.js svelte.config.js && vite build; rc=$?; cp svelte.config.bak.js svelte.config.js && rm svelte.config.bak.js; exit $rc",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "svelte-kit sync && eslint . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@newrelic/browser-agent": "^1.315.0",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.1",
    "@types/node": "^24.9.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.17.0",
    "front-matter": "^4.0.2",
    "globals": "^17.5.0",
    "marked": "^18.0.1",
    "svelte": "^5.0.0-next.272",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
