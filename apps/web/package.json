{
  "name": "earnit-kids",
  "version": "1.0.0",
  "description": "EarnIt Kids - minimal coin management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:web": "node src/server.js",
    "start:backend": "mvn -f ../backend/pom.xml quarkus:dev",
    "test": "node --test tests/*.test.js tests/unit/*.test.js",
    "test:backend": "mvn -f ../backend/pom.xml test",
    "test:integration": "NODE_ENV=test node --test tests/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js tests/unit/*.test.js",
    "test:ui:smoke": "node --test tests/ui/*.test.js",
    "test:ui:e2e": "env -u NO_COLOR PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:ui:e2e:safe": "node scripts/run-ui-e2e.js --allow-sandbox-fallback",
    "test:ui": "npm run test:ui:smoke && npm run test:ui:e2e",
    "verify:css-assets": "NODE_ENV=production node --test tests/ui/cssLinks.test.js",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "lint": "npm run lint:syntax && npm run lint:commonjs && npm run lint:eslint",
    "lint:syntax": "node scripts/lint-syntax.js",
    "lint:commonjs": "node scripts/lint-commonjs.js",
    "lint:eslint": "eslint src scripts public/js tests --max-warnings=0",
    "check": "npm run lint && npm run test:coverage",
    "build": "node scripts/build.js",
    "build:backend": "mvn -f ../backend/pom.xml -DskipTests package",
    "check:split": "npm run lint && npm test && npm run build && npm run test:backend && npm run build:backend",
    "docker:config": "docker compose config",
    "docker:build": "docker compose build web backend",
    "generate:file-headers": "node scripts/generate-file-headers.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "c8": "^10.1.3",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.21.0",
    "proxyquire": "^2.1.3",
    "terser": "^5.46.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "form-data": "^4.0.5",
    "front-matter": "^4.0.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "mailgun.js": "^12.7.0",
    "marked": "^17.0.3",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.1",
    "web-push": "^3.6.7",
    "ws": "^8.19.0"
  }
}
