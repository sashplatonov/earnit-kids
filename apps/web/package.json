{
  "name": "earnit-kids-web-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 0.0.0.0 --port 4173",
    "build": "node scripts/build.mjs",
    "build:static": "STATIC_BUILD=true node scripts/build.mjs",
    "generate:public": "node scripts/public-site/generate.mjs",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "svelte-kit sync && eslint . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test tests/e2e/workspace-entry.spec.ts tests/e2e/workspace-access.spec.ts tests/e2e/workspace-invitations.spec.ts tests/e2e/telegram-auth.spec.ts tests/e2e/pwa-browser-push.spec.ts --grep \"entry is usable|unauthenticated localized|authenticated child sees|Telegram auth surface|workspace registers\""
  },
  "dependencies": {
    "@lucide/svelte": "^1.35.0",
    "http-proxy-3": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "front-matter": "^4.0.2",
    "globals": "^17.11.0",
    "marked": "^18.0.11",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
