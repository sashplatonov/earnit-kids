FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

RUN apt-get update && apt-get install -y wget ca-certificates && rm -rf /var/lib/apt/lists/*

COPY apps/backend/.mvn/ .mvn/
COPY apps/backend/mvnw ./mvnw
COPY apps/backend/pom.xml ./pom.xml
COPY apps/backend/config ./config
COPY apps/backend/src ./src

RUN sh ./mvnw -DskipTests -Dcheckstyle.skip=true package

FROM eclipse-temurin:25-jdk
WORKDIR /work

RUN apt-get update \
	&& apt-get install -y wget ca-certificates gnupg \
	&& install -d /usr/share/postgresql-common/pgdg \
	&& wget -qO /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
	&& echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo ${VERSION_CODENAME})-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
	&& apt-get update \
	&& apt-get install -y postgresql-client-18 \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/quarkus-app/lib/ ./lib/
COPY --from=build /workspace/target/quarkus-app/*.jar ./
COPY --from=build /workspace/target/quarkus-app/app/ ./app/
COPY --from=build /workspace/target/quarkus-app/quarkus/ ./quarkus/

ENV QUARKUS_HTTP_HOST=0.0.0.0
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 CMD wget -q --spider http://127.0.0.1:8080/q/health/ready || exit 1

CMD ["java", "-jar", "quarkus-run.jar"]
