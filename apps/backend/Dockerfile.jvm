# syntax=docker/dockerfile:1.7

FROM eclipse-temurin:25-jdk-jammy AS build
WORKDIR /workspace

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
	apt-get update \
	&& apt-get install -y --no-install-recommends wget ca-certificates unzip \
	&& rm -rf /var/lib/apt/lists/*

COPY apps/backend/.mvn/ .mvn/
COPY apps/backend/mvnw ./mvnw
COPY apps/backend/pom.xml ./pom.xml

RUN --mount=type=cache,target=/root/.m2,sharing=locked \
	sh ./mvnw -B -ntp -Dmaven.test.skip=true dependency:go-offline

COPY apps/backend/config ./config
COPY apps/backend/src ./src

RUN --mount=type=cache,target=/root/.m2,sharing=locked \
	sh ./mvnw -B -ntp -Dmaven.test.skip=true -Dcheckstyle.skip=true -Dpmd.skip=true -Dspotbugs.skip=true -Djacoco.skip=true package

FROM eclipse-temurin:25-jre-jammy
WORKDIR /work

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
	apt-get update \
	&& apt-get install -y --no-install-recommends wget ca-certificates unzip \
	&& rm -rf /var/lib/apt/lists/*

ARG NEW_RELIC_AGENT_VERSION=9.3.0
ENV NEW_RELIC_HOME=/opt/newrelic \
	NEW_RELIC_CONFIG_FILE=/opt/newrelic/newrelic.yml \
	NEW_RELIC_AGENT_ENABLED=false

RUN mkdir -p /opt/newrelic \
	&& wget -qO /tmp/newrelic-java.zip "https://download.newrelic.com/newrelic/java-agent/newrelic-agent/${NEW_RELIC_AGENT_VERSION}/newrelic-java.zip" \
	&& unzip -q /tmp/newrelic-java.zip -d /opt \
	&& rm -f /tmp/newrelic-java.zip

USER 185

COPY --from=build /workspace/target/quarkus-app/lib/ ./lib/
COPY --from=build /workspace/target/quarkus-app/*.jar ./
COPY --from=build /workspace/target/quarkus-app/app/ ./app/
COPY --from=build /workspace/target/quarkus-app/quarkus/ ./quarkus/
COPY apps/backend/ops/newrelic/newrelic.yml /opt/newrelic/newrelic.yml
COPY apps/backend/ops/newrelic/extensions/ /opt/newrelic/extensions/

ENV QUARKUS_HTTP_HOST=0.0.0.0
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 CMD wget -q --spider http://127.0.0.1:8080/q/health/ready || exit 1

CMD ["/bin/sh", "-ec", "if [ \"${NEW_RELIC_AGENT_ENABLED:-false}\" = \"true\" ]; then exec java -Dnewrelic.config.file=${NEW_RELIC_CONFIG_FILE} -Dnewrelic.config.license_key=\"${NEW_RELIC_LICENSE_KEY:-}\" -Dnewrelic.config.app_name=\"${NEW_RELIC_APP_NAME:-earnit-kids-backend}\" -Dnewrelic.environment=${DEPLOYMENT_ENV:-development} -Dnewrelic.config.application_logging.forwarding.enabled=${NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED:-false} -Dnewrelic.config.application_logging.forwarding.max_samples_stored=${NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED:-10000} -Dnewrelic.config.application_logging.local_decorating.enabled=${NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED:-false} -javaagent:${NEW_RELIC_HOME}/newrelic.jar -jar quarkus-run.jar; fi; exec java -jar quarkus-run.jar"]
