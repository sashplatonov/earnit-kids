# -------------------------------
# Backend overrides
# -------------------------------
QUARKUS_HTTP_PORT=8080
FRONTEND_URL=http://localhost:3000
JWT_SECRET=local-dev-secret-change-in-prod
SESSION_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=7776000
PRODUCTION=false

# -------------------------------
# Monitoring
# -------------------------------
HTTP_METRICS_PAYLOAD_ESTIMATION_ENABLED=true
HTTP_METRICS_PAYLOAD_ESTIMATION_MAX_COLLECTION_SIZE=256
HTTP_METRICS_SLOW_REQUEST_THRESHOLD_MS=750
HTTP_METRICS_SLOW_QUERY_THRESHOLD_MS=250
BASE_DATA_CACHE_TTL=PT5M
SYSTEM_OVERVIEW_CACHE_TTL=PT30S
ANALYTICS_CACHE_TTL=PT60S
ADMIN_DASHBOARD_CACHE_TTL=PT2M
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=earnit-kids-backend
NEW_RELIC_AGENT_ENABLED=false
DEPLOYMENT_ENV=development
NEW_RELIC_METRICS_ENABLED=false
NEW_RELIC_OTLP_METRICS_ENDPOINT=https://otlp.nr-data.net
NEW_RELIC_OTLP_METRICS_PROTOCOL=http/protobuf
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED=10000
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=false

# -------------------------------
# Database overrides
# -------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/earnit_kids
DB_USER=postgres
DB_PASSWORD=change-me
DB_SCHEMA=earnit_kids

# -------------------------------
# Google Identity (server-side OAuth)
# Enable server-side OAuth and provide client id/secret.
# GOOGLE_AUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_AUTH_CLIENT_SECRET=your-client-secret
# GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/login-google/callback
# -------------------------------
GOOGLE_AUTH_REDIRECT_URI=
